# ReceiptRAG Environment Variables Example

# Backend Core Configuration
ENVIRONMENT=development
SECRET_KEY=receiptrag_super_secret_jwt_key_2026_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Settings (Default: Local SQLite, optional: PostgreSQL + pgvector)
DATABASE_URL=sqlite:///./receiptrag.db
# DATABASE_URL=postgresql://receipt_user:receipt_pass@localhost:5432/receiptrag_db

# Storage Directories
UPLOAD_DIR=./uploads
VECTOR_DB_DIR=./chroma_db

# LLM & Embedding Settings (Optional: Leave empty for local fallback)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# OCR Binary Path (Optional on Windows if tesseract is on custom PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
